{
  "name": "log-pose-local",
  "private": true,
  "scripts": {
    "dev": "bash scripts/dev.sh",
    "lint": "oxlint api scripts tests web",
    "lint:experimental": "oxlint --no-ignore experiments/ml/mlops-2024/tests",
    "dashboard": "node scripts/market_field_dev.js",
    "build:market-field": "PYTHONPATH=src python3 scripts/build_market_field_graph.py && node scripts/build_market_field_layout.js",
    "build:atlas": "PYTHONPATH=src python3 scripts/build_atlas_snapshot.py",
    "check:atlas": "PYTHONPATH=src python3 scripts/build_atlas_snapshot.py --check",
    "test:atlas": "node --test tests/atlas-api.test.js tests/atlas-view.test.js tests/atlas-runtime.test.js tests/atlas-postgres-api.test.js",
    "test:dashboard": "node --test tests/research-model.test.js tests/discovery-topology-model.test.js tests/temporal-graph.test.js tests/temporal-graph-webgl.test.js tests/market-route.test.js tests/market-field-api.test.js tests/market-field-provenance.test.js tests/experimental-boundary.test.js",
    "test:experimental": "node --test experiments/ml/mlops-2024/tests/*.test.js"
  },
  "devDependencies": {
    "@oxlint/plugins": "^1.85.0",
    "jsdom": "^26.1.0",
    "oxlint": "^1.85.0"
  },
  "dependencies": {
    "pg": "^8.16.3"
  }
}
